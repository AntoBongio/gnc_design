<?xml version="1.0"?>
<!--
  Six-wheel robot.
  Overall envelope: 7.0 m long (x), 4.5 m wide (y), 4.5 m high (z).
  Body box: 7.0 x 4.5 x 3.3 m, sitting on top of the wheels (z = 1.2 m to 4.5 m).
  Wheels: radius 0.6 m, width 0.4 m, 3 per side at x = +2.4, 0, -2.4 m, y = +/-1.9 m.
  Masses and inertias are placeholder values; replace them with measured data.
-->
<sdf version="1.9">
  <model name="six_wheel_robot">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- Reference frame of the robot body. Origin at the centre of the body box. -->
    <link name="body_link">
      <pose>0 0 2.85 0 0 0</pose>
      <inertial>
        <mass>1500.0</mass>
        <inertia>
          <ixx>3892.5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>7486.25</iyy>
          <iyz>0</iyz>
          <izz>8656.25</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>7.0 4.5 3.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>7.0 4.5 3.3</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Left side wheels (y = +1.9 m) -->
    <link name="front_left_wheel">
      <pose relative_to="body_link">2.4 1.9 -2.25 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.1667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.0</iyy>
          <iyz>0</iyz>
          <izz>5.1667</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="mid_left_wheel">
      <pose relative_to="body_link">0 1.9 -2.25 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.1667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.0</iyy>
          <iyz>0</iyz>
          <izz>5.1667</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rear_left_wheel">
      <pose relative_to="body_link">-2.4 1.9 -2.25 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.1667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.0</iyy>
          <iyz>0</iyz>
          <izz>5.1667</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Right side wheels (y = -1.9 m) -->
    <link name="front_right_wheel">
      <pose relative_to="body_link">2.4 -1.9 -2.25 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.1667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.0</iyy>
          <iyz>0</iyz>
          <izz>5.1667</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="mid_right_wheel">
      <pose relative_to="body_link">0 -1.9 -2.25 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.1667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.0</iyy>
          <iyz>0</iyz>
          <izz>5.1667</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rear_right_wheel">
      <pose relative_to="body_link">-2.4 -1.9 -2.25 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.1667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>9.0</iyy>
          <iyz>0</iyz>
          <izz>5.1667</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.6</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Wheel joints: continuous rotation about the lateral (y) axis -->
    <joint name="front_left_wheel_joint" type="continuous">
      <parent>body_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="mid_left_wheel_joint" type="continuous">
      <parent>body_link</parent>
      <child>mid_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="continuous">
      <parent>body_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="continuous">
      <parent>body_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="mid_right_wheel_joint" type="continuous">
      <parent>body_link</parent>
      <child>mid_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="continuous">
      <parent>body_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>
  </model>
</sdf>
